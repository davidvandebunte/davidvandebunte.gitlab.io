#!/usr/bin/env sh
set -x -o errexit -o nounset

if [ -z ${GITLAB_CI+x} ]; then
    echo "Building locally"

    ./scripts/install-bazelisk
    ./bazelisk build //jb:cache_tar
else
    python3 -m dvc pull jb/tar/notes/ssc/raster
    python3 -m dvc pull jb/rethinking/image.tar
    docker load -i ./jb/rethinking/image.tar
fi

cd jb
    docker run --name build_jb \
        --env NB_USER="${USER:=xxx}" \
        --mount type=bind,source=$(pwd)/jupyter_cache,target=/jupyter_cache \
        --volume "$(pwd)"/tar:/home/jovyan/work \
        --entrypoint /bin/bash \
        --workdir /home/jovyan/work \
        install_rethinking:latest /home/jovyan/work/jb-build
cd -
docker cp build_jb:/tmp/_build/html public/executable-notes
docker rm build_jb
