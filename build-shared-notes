#!/usr/bin/env sh
set -o errexit -o nounset -o xtrace

python3 -m dvc pull hugo/docker_image/docker_image.tar
docker load -i hugo/docker_image/docker_image.tar

echo "${CI_PROJECT_NAME:=personal-notes}"
if [ "$CI_PROJECT_NAME" = "personal-notes" ]; then
    BASE_URL="https://$CI_PROJECT_NAMESPACE.gitlab.io/-/$CI_PROJECT_NAME/-/jobs/$CI_JOB_ID/artifacts/public/shared-notes"
fi
time docker run --rm \
    -u "$(id -u)":"$(id -g)" \
    --mount type=bind,source="$(pwd)",target=/src \
    --workdir /src/hugo \
    user_hugo_img \
    hugo --enableGitInfo \
    ${BASE_URL:+ --baseURL="$BASE_URL"} \
    -d shared-notes
cp -r hugo/shared-notes public
