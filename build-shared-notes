#!/usr/bin/env sh

DOCKER_CONFIG=/tmp/.ci_docker
export DOCKER_CONFIG

mkdir -p public
echo "${CI_PROJECT_NAME:=personal-notes}"
time docker run --rm \
    -u "$(id -u)":"$(id -g)" \
    --mount type=bind,source="$(pwd)",target=/src \
    registry.gitlab.com/davidvandebunte/${CI_PROJECT_NAME}:user_hugo \
    hugo --enableGitInfo -d public/shared-notes
