#!/usr/bin/env sh
mkdir -p public
docker run --rm \
    --user $(id -u) \
    --mount type=bind,source=$(pwd),target=/home/jovyan \
    jln \
    jupyter-book build content/post/mynewbook --path-output public/tmp
if [ $? -ne 0 ]; then
    exit 1
fi
rm -rf public/executable-notes
mv public/tmp/_build/html public/executable-notes
rm -rf public/tmp
