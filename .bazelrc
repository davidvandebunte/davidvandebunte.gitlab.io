startup --output_user_root=/tmp/output_user_root

build --subcommands
build --verbose_failures
build --remote_cache=grpc://localhost:9092
build --output_filter=
build --show_timestamps
build --sandbox_debug

# - https://github.com/buchgr/bazel-remote/issues/241
# - https://docs.bazel.build/versions/main/command-line-reference.html#flag--remote_timeout
build --remote_timeout=240s
